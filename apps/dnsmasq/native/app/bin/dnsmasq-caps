#!/bin/sh
set -eu
[ "$(id -u)" -eq 0 ] || { echo 'dnsmasq-caps requires root' >&2; exit 1; }
[ "${1:-}" = apply ] || { echo 'usage: dnsmasq-caps apply <binary>' >&2; exit 2; }
RAW="${2:-}"
TARGET=$(readlink -f -- "$RAW" 2>/dev/null || true)
case "$TARGET" in
  /var/apps/dnsmasq-for-fnos/target/bin/dnsmasq|/vol*/@appcenter/dnsmasq-for-fnos/bin/dnsmasq|/vol*/@appcenter/dnsmasq-for-fnos/target/bin/dnsmasq|/vol*/@appdata/dnsmasq-for-fnos/target/bin/dnsmasq|/vol*/@appdata/dnsmasq-for-fnos/bin/dnsmasq) ;;
  *) echo "invalid dnsmasq path: ${TARGET:-$RAW}" >&2; exit 2 ;;
esac
[ -f "$TARGET" ] || { echo 'dnsmasq binary not found' >&2; exit 1; }
SETCAP=""
for candidate in /usr/sbin/setcap /sbin/setcap /usr/bin/setcap /bin/setcap; do
  if [ -x "$candidate" ]; then SETCAP="$candidate"; break; fi
done
if [ -z "$SETCAP" ]; then SETCAP=$(command -v setcap 2>/dev/null || true); fi
[ -n "$SETCAP" ] || { echo 'setcap not found' >&2; exit 1; }
exec "$SETCAP" cap_net_bind_service+ep "$TARGET"
