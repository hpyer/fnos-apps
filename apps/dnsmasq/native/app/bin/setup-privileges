#!/bin/sh
set -eu
[ "$(id -u)" -eq 0 ] || { echo 'setup-privileges requires root' >&2; exit 1; }
APP_DEST=$(readlink -f -- "${1:-/var/apps/dnsmasq-for-fnos/target}" 2>/dev/null || true)
case "$APP_DEST" in
  /var/apps/dnsmasq-for-fnos/target|/vol*/@appcenter/dnsmasq-for-fnos|/vol*/@appcenter/dnsmasq-for-fnos/target|/vol*/@appdata/dnsmasq-for-fnos/target|/vol*/@appdata/dnsmasq-for-fnos) ;;
  *) echo "unexpected application directory: ${1:-}" >&2; exit 2 ;;
esac
INSTALL_DIR=/usr/local/lib/dnsmasq-for-fnos
USER_NAME=dnsmasq_for_fnos
SELF=$(readlink -f -- "$0" 2>/dev/null || echo "$0")
SELF_DIR=$(dirname "$SELF")
SRC=""
for candidate in "$APP_DEST/bin" "$APP_DEST/app/bin" "$SELF_DIR"; do
  if [ -f "$candidate/dnsmasq-caps" ] && [ -f "$candidate/setup-privileges" ]; then SRC="$candidate"; break; fi
done
if [ -z "$SRC" ]; then
  for base in "$APP_DEST" "$(dirname "$APP_DEST")"; do
    found=$(find "$base" -maxdepth 4 -type f -name dnsmasq-caps 2>/dev/null | head -n 1)
    if [ -n "$found" ] && [ -f "$(dirname "$found")/setup-privileges" ]; then SRC=$(dirname "$found"); break; fi
  done
fi
[ -n "$SRC" ] || { echo "missing helper: dnsmasq-caps (searched $APP_DEST)" >&2; exit 1; }
install -d -m 0755 -o root -g root "$INSTALL_DIR"
for helper in dnsmasq-caps setup-privileges; do
  if [ "$SRC/$helper" != "$INSTALL_DIR/$helper" ]; then
    install -m 0755 -o root -g root "$SRC/$helper" "$INSTALL_DIR/$helper"
  fi
done
for helper in dnsmasq-caps setup-privileges; do
  owner=$(stat -c '%u' "$INSTALL_DIR/$helper")
  mode=$(stat -c '%a' "$INSTALL_DIR/$helper")
  [ "$owner" = 0 ] || { echo "helper not owned by root: $helper" >&2; exit 1; }
  [ $((0$mode & 022)) -eq 0 ] || { echo "helper is group/world writable: $helper" >&2; exit 1; }
done
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT HUP INT TERM
cat >"$TMP" <<EOF
# Managed by Dnsmasq for fnOS; keep the helper surface minimal.
Defaults:$USER_NAME !requiretty
$USER_NAME ALL=(root) NOPASSWD: $INSTALL_DIR/dnsmasq-caps apply *
EOF
if command -v visudo >/dev/null 2>&1; then
  visudo -cf "$TMP" >/dev/null || { echo 'sudoers validation failed' >&2; exit 1; }
fi
install -m 0440 "$TMP" /etc/sudoers.d/dnsmasq-for-fnos
echo 'dnsmasq-for-fnos privilege helpers installed'
