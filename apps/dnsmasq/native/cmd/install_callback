#!/bin/sh
# Privilege setup is best-effort during package installation. If fnOS runs this
# hook without root, the app asks the administrator to authorize once before the
# first DNS start.
log="${TRIM_TEMP_LOGFILE:-/dev/stderr}"
[ "$(id -u)" -eq 0 ] || exit 0
SRC="${TRIM_APPDEST}/bin"
[ -x "$SRC/setup-privileges" ] || { echo 'warning: missing dnsmasq privilege helper; authorize from the app' >"$log"; exit 0; }
INSTALL_DIR=/usr/local/lib/dnsmasq-for-fnos
if ! install -d -m 0755 -o root -g root "$INSTALL_DIR" \
  || ! install -m 0755 -o root -g root "$SRC/setup-privileges" "$INSTALL_DIR/setup-privileges" \
  || ! install -m 0755 -o root -g root "$SRC/dnsmasq-caps" "$INSTALL_DIR/dnsmasq-caps"; then
  echo 'warning: failed to copy dnsmasq privilege helper; authorize from the app' >"$log"
  exit 0
fi
if ! "$INSTALL_DIR/setup-privileges" "${TRIM_APPDEST}"; then
  echo 'warning: failed to install dnsmasq sudoers helper; authorize from the app' >"$log"
  exit 0
fi
if ! "$INSTALL_DIR/dnsmasq-caps" apply "${TRIM_APPDEST}/bin/dnsmasq"; then
  echo 'warning: failed to grant dnsmasq port 53 capability' >"$log"
fi
exit 0
