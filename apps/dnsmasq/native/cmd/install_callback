#!/bin/sh
# Capability setup is optional during package installation. A failure must not
# make the whole app uninstallable; the manager reports the 53/t capability
# problem when the user starts DNS.
log="${TRIM_TEMP_LOGFILE:-/dev/stderr}"
if [ "$(id -u)" -eq 0 ] && [ -x "${TRIM_APPDEST}/bin/setup-privileges" ]; then
  if ! install -d -m 0755 -o root -g root /usr/local/lib/dnsmasq-for-fnos \
    || ! install -m 0755 -o root -g root "${TRIM_APPDEST}/bin/setup-privileges" /usr/local/lib/dnsmasq-for-fnos/setup-privileges \
    || ! install -m 0755 -o root -g root "${TRIM_APPDEST}/bin/dnsmasq-caps" /usr/local/lib/dnsmasq-for-fnos/dnsmasq-caps; then
    echo 'warning: failed to copy dnsmasq root helper; DNS 53 capability is not prepared' >"$log"
    exit 0
  fi
  if ! /usr/local/lib/dnsmasq-for-fnos/setup-privileges "${TRIM_APPDEST}"; then
    echo 'warning: failed to install dnsmasq sudoers helper; DNS 53 capability is not prepared' >"$log"
    exit 0
  fi
  /usr/local/lib/dnsmasq-for-fnos/dnsmasq-caps apply "${TRIM_APPDEST}/bin/dnsmasq" || echo 'warning: failed to apply dnsmasq 53 capability' >"$log"
fi
exit 0
