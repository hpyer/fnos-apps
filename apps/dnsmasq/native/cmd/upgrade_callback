#!/bin/sh
# Refresh the root-owned helpers after an upgrade. The replacement binary loses
# its file capability, so apply it again when this hook has root; otherwise the
# manager re-applies it through the existing sudoers rule on the next start.
log="${TRIM_TEMP_LOGFILE:-/dev/stderr}"
[ "$(id -u)" -eq 0 ] || exit 0
SRC="${TRIM_APPDEST}/bin"
[ -x "$SRC/setup-privileges" ] || { echo 'warning: missing dnsmasq privilege helper after upgrade' >"$log"; exit 0; }
INSTALL_DIR=/usr/local/lib/dnsmasq-for-fnos
if ! install -d -m 0755 -o root -g root "$INSTALL_DIR" \
  || ! install -m 0755 -o root -g root "$SRC/setup-privileges" "$INSTALL_DIR/setup-privileges" \
  || ! install -m 0755 -o root -g root "$SRC/dnsmasq-caps" "$INSTALL_DIR/dnsmasq-caps"; then
  echo 'warning: failed to refresh dnsmasq privilege helper' >"$log"
  exit 0
fi
if ! "$INSTALL_DIR/setup-privileges" "${TRIM_APPDEST}"; then
  echo 'warning: failed to refresh dnsmasq sudoers helper' >"$log"
  exit 0
fi
if ! "$INSTALL_DIR/dnsmasq-caps" apply "${TRIM_APPDEST}/bin/dnsmasq"; then
  echo 'warning: failed to re-apply dnsmasq port 53 capability' >"$log"
fi
exit 0
