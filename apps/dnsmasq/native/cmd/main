#!/bin/sh
set -eu
export PATH="/var/apps/nodejs_v24/target/bin:$PATH"
PID_FILE="${TRIM_PKGVAR}/manager.pid"
ENTRY="${TRIM_APPDEST}/main.mjs"
case "${1:-}" in
  start) mkdir -p "${TRIM_PKGVAR}/logs"; if [ -r "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then exit 0; fi; nohup node "$ENTRY" >>"${TRIM_PKGVAR}/logs/stdout.log" 2>&1 & echo $! >"$PID_FILE" ;;
  stop) [ -r "$PID_FILE" ] && kill "$(cat "$PID_FILE")" 2>/dev/null || true; rm -f "$PID_FILE"; rm -f "${TRIM_APPDEST}/app.sock" ;;
  status) [ -r "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null ;;
  *) exit 1 ;;
esac
