{
  "name": "@fnos/clash",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@fnos/privilege": "workspace:*",
    "@fnos/version-check": "workspace:*",
    "@fnos/toast": "workspace:*"
  },
  "fnos": {
    "versionFile": "app/version",
    "archPrune": {
      "x86": [
        "app/cores/arm64"
      ],
      "arm": [
        "app/cores/x86_64"
      ]
    }
  }
}
