#!/bin/sh
set -eu
# Refresh the root-owned helpers after fnOS replaces the target directory.
# A helper refresh failure must not abort the upgrade: the page can reinstall
# the helpers later, and the app itself runs as the package user.
if [ "$(id -u)" -eq 0 ] && [ -x "${TRIM_APPDEST}/bin/setup-privileges" ]; then
  {
    install -d -m 0755 -o root -g root /usr/local/lib/clash-for-fnos &&
      install -m 0755 -o root -g root "${TRIM_APPDEST}/bin/setup-privileges" /usr/local/lib/clash-for-fnos/setup-privileges &&
      /usr/local/lib/clash-for-fnos/setup-privileges "${TRIM_APPDEST}"
  } || echo 'warning: failed to refresh Clash service-mode helpers' >&2
fi
exit 0
