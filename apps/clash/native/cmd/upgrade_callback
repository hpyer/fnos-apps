#!/bin/sh
set -eu
if [ "$(id -u)" -eq 0 ] && [ -x "${TRIM_APPDEST}/bin/setup-privileges" ]; then
  install -d -m 0755 -o root -g root /usr/local/lib/clash-for-fnos
  install -m 0755 -o root -g root "${TRIM_APPDEST}/bin/setup-privileges" /usr/local/lib/clash-for-fnos/setup-privileges
  /usr/local/lib/clash-for-fnos/setup-privileges "${TRIM_APPDEST}" || echo 'warning: failed to refresh Clash service-mode helpers' >&2
fi
exit 0
