#!/bin/sh
set -eu
# Install root-owned copies of the narrow network helpers and the sudoers rule.
# The application directory itself stays owned by the package user; the copies
# below are the only programs the package user may execute as root.
[ "$(id -u)" -eq 0 ] || { echo 'setup-privileges requires root' >&2; exit 1; }
APP_DEST="${1:-/var/apps/clash-for-fnos/target}"
case "$APP_DEST" in
  /var/apps/clash-for-fnos/target|/vol*/@appdata/clash-for-fnos/target|/vol*/@appcenter/clash-for-fnos/target) ;;
  *) echo "unexpected application directory: $APP_DEST" >&2; exit 2 ;;
esac
INSTALL_DIR=/usr/local/lib/clash-for-fnos
USER_NAME=clash_for_fnos
SELF=$(readlink -f "$0" 2>/dev/null || echo "$0")
SELF_DIR=$(dirname "$SELF")
SRC=""
for candidate in "$SELF_DIR" "$APP_DEST/bin" "$APP_DEST/app/bin"; do
  [ -f "$candidate/system-proxy" ] && [ -f "$candidate/core-caps" ] && SRC="$candidate" && break
done
if [ -z "$SRC" ]; then
  for base in "$APP_DEST" "$(dirname "$APP_DEST")"; do
    found=$(find "$base" -maxdepth 4 -type f -name system-proxy 2>/dev/null | head -n 1)
    if [ -n "$found" ] && [ -f "$(dirname "$found")/core-caps" ]; then
      SRC=$(dirname "$found")
      break
    fi
  done
fi
[ -n "$SRC" ] || { echo "missing helper: system-proxy (searched $APP_DEST)" >&2; exit 1; }
install -d -m 0755 -o root -g root "$INSTALL_DIR"
for helper in system-proxy core-caps; do
  install -m 0755 -o root -g root "$SRC/$helper" "$INSTALL_DIR/$helper"
done
if [ "$SELF" != "$INSTALL_DIR/setup-privileges" ]; then
  install -m 0755 -o root -g root "$SRC/setup-privileges" "$INSTALL_DIR/setup-privileges"
fi
for helper in system-proxy core-caps; do
  owner=$(stat -c '%u' "$INSTALL_DIR/$helper")
  mode=$(stat -c '%a' "$INSTALL_DIR/$helper")
  [ "$owner" = 0 ] || { echo "helper not owned by root: $helper" >&2; exit 1; }
  [ $((0$mode & 022)) -eq 0 ] || { echo "helper is group/world writable: $helper" >&2; exit 1; }
done
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT HUP INT TERM
cat > "$TMP" <<EOF
# Managed by Clash for fnOS; keep the helper surface minimal.
Defaults:$USER_NAME !requiretty
$USER_NAME ALL=(root) NOPASSWD: $INSTALL_DIR/system-proxy enable *, $INSTALL_DIR/system-proxy disable *, $INSTALL_DIR/core-caps apply * *
EOF
if command -v visudo >/dev/null 2>&1; then
  visudo -cf "$TMP" >/dev/null || { echo 'sudoers validation failed' >&2; exit 1; }
fi
install -m 0440 "$TMP" /etc/sudoers.d/clash-for-fnos
echo 'clash-for-fnos service-mode helpers installed'
